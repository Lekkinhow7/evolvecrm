# Exemplo de variáveis de ambiente (NÃO coloque segredos aqui)
# Copie para .env.local e preencha com seus valores.

# --- Next.js / Supabase (App) ---
# URL do projeto no Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase (Settings → API Keys)
# Novo formato: sb_publishable_... (recomendado)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Fallback legado (se seu projeto ainda usa JWT anon key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta do Supabase (APENAS server-side).
# Novo formato: sb_secret_... (recomendado)
# Nunca exponha no client e nunca comite.
SUPABASE_SECRET_KEY=
# Fallback legado (se seu projeto ainda usa JWT service_role key):
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI Agent Internal API ---
# Secret para autenticar chamadas internas entre Edge Functions e a API de AI.
# Gere um valor seguro: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- Voice AI (ElevenLabs) ---
# API key é configurada na interface (Settings) e salva no banco (organization_settings).
# HMAC secret para verificação de webhooks (infra-level, fica em env var)
ELEVENLABS_WEBHOOK_SECRET=

# --- Dev-only ---
# Habilita rotas internas de teste de IA em desenvolvimento.
ALLOW_AI_TEST_ROUTE=false

# Habilita rotas internas de mock de UI em desenvolvimento.
ALLOW_UI_MOCKS_ROUTE=false

# --- Installer (ops only) ---
# Se INSTALLER_ENABLED nao estiver definido, o instalador fica liberado ate a primeira instalacao.
# Defina como false para desativar o instalador (recomendado apos o setup).
INSTALLER_ENABLED=false

# Token opcional para proteger o instalador (se definido, passa a ser obrigatorio).
INSTALLER_TOKEN=

# URL base da aplicação — usada em links do Telegram
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sucção Zero (ativação exclusiva por instalação) ---
# Mantenha false em instalações genéricas e no CRM Alice.
SUCCAOZERO_CANONICAL_ENABLED=false
SUCCAOZERO_ORGANIZATION_ID=
SUCCAOZERO_BOARD_KEY=succaozero
SUCCAOZERO_SUPABASE_PROJECT_REF=

# Refs e conexões usados somente por scripts operacionais server-side.
# Nunca exponha estas URLs ao navegador nem comite seus valores reais.
SUCCAOZERO_AGENT_SUPABASE_PROJECT_REF=
SUCCAOZERO_CRM_DATABASE_URL=
SUCCAOZERO_AGENT_DATABASE_URL=
SUCCAOZERO_RESTORE_DATABASE_URL=

# Origens públicas autorizadas a enviar leads para esta instalação.
SITE_LEAD_ALLOWED_ORIGINS=https://succaozero.com.br,https://www.succaozero.com.br
